(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the yellow and white mug into the microwave and close the microwave, then put the black bowl into the bottom drawer and close the drawer.)
    (:regions
      (microwave_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.31 0.27 -0.28 0.30)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (0.22 0.27 0.23 0.30)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_yellow_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.10 -0.18 -0.05 -0.13)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (0.07 -0.18 0.12 -0.13)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target microwave_1)
      )
      (heating_region
          (:target microwave_1)
      )
      (top_side
          (:target white_cabinet_1)
      )
      (top_region
          (:target white_cabinet_1)
      )
      (middle_region
          (:target white_cabinet_1)
      )
      (bottom_region
          (:target white_cabinet_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
    white_cabinet_1 - white_cabinet
  )

  (:objects
    white_yellow_mug_1 - white_yellow_mug
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    microwave_1
    white_yellow_mug_1
    white_cabinet_1
    akita_black_bowl_1
  )

  (:init
    (On microwave_1 kitchen_table_microwave_init_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
    (On white_yellow_mug_1 kitchen_table_white_yellow_mug_init_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
    (Open microwave_1)
    (Open white_cabinet_1_bottom_region)
  )

  (:goal
    (And
      (In white_yellow_mug_1 microwave_1_heating_region)
      (Close microwave_1)
      (In akita_black_bowl_1 white_cabinet_1_bottom_region)
      (Close white_cabinet_1_bottom_region)
    )
  )

)
